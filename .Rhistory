mydat <- as.data.frame(adjusted_TPMcount.Batch5) %>%
mutate(Gene = mapIds(org.Mm.eg.db,keys = rownames(.),column = "SYMBOL",keytype = "ENSEMBL",multiVals = "first"),.before=1) %>%
pivot_longer(cols=-Gene,names_to="Names",values_to="logTPM") %>% na.omit(.)
mydat_with_metadata.gp5 <-
mydat %>% left_join(metadata_B5, by = "Names") %>% dplyr::select(Gene, Names, Sex, Age, Genotype, Group, logTPM) %>%
mutate(sex = ifelse(Sex %in% "Male", 1, 0))  %>%
mutate(Ptk2b = ifelse(Genotype %in% c("LOAD2.Ptk2b-KI"), 1, 0)) %>%
mutate(Il34 = ifelse(Genotype %in% c("LOAD2.Il34-KI"), 1, 0)) %>%
mutate(Scimp = ifelse(Genotype %in% c("LOAD2.Scimp-KI"), 1, 0)) %>%
mutate(Adamts4 = ifelse(Genotype %in% c("LOAD2.Adamts4"), 1, 0)) %>%
mutate(Age=factor(Age,levels=c(4,12))) %>%
dplyr::select(-Sex, -Genotype)
lms.case.4M.gp2 <- mydat_with_metadata.gp5 %>% filter(Age == 4) %>% split(.$Gene) %>% map(~lm(logTPM ~ sex + Adamts4 + Scimp  + Ptk2b + Il34, data=.x)) %>% map(summary)
effects.4M.gp2 <- as.data.frame(bind_rows( lapply(lms.case.4M.gp2, function(x) x$coefficients[,"Estimate"] ))) %>% mutate(names = names(lms.case.4M.gp2)) %>% column_to_rownames(.,var="names")
pvals.4M.gp2 <- as.data.frame(bind_rows( lapply( lms.case.4M.gp2, function(x) x$coefficients[,"Pr(>|t|)"] ))) %>% mutate(names = names(lms.case.4M.gp2)) %>% column_to_rownames(.,var="names")
colnames(pvals.4M.gp2) <- colnames(effects.4M.gp2) <- c("(Intercept)", "Sex (Male)", "LOAD2.Adamts4","LOAD2.Scimp-KI", "LOAD2.Ptk2b-KI", "LOAD2.Il34-KI")
rna_effects.4M.gp2 <- effects.4M.gp2 %>% tibble::rownames_to_column(.,"Gene") %>% dplyr::select(-"(Intercept)") %>% pivot_longer(cols=-Gene,names_to="Variant",values_to="value")
rna_pvals.4M.gp2 <- pvals.4M.gp2 %>% tibble::rownames_to_column(.,"Gene") %>% dplyr::select(-"(Intercept)") %>% pivot_longer(cols=-Gene,names_to="Variant",values_to="pval")
lms.case.12M.gp2 <- mydat_with_metadata.gp5 %>% filter(Age == 12) %>% split(.$Gene) %>% map(~lm(logTPM ~ sex + Adamts4 + Scimp  + Ptk2b + Il34, data=.x)) %>% map(summary)
effects.12M.gp2 <- as.data.frame(bind_rows( lapply(lms.case.12M.gp2, function(x) x$coefficients[,"Estimate"] ))) %>% mutate(names = names(lms.case.12M.gp2)) %>% column_to_rownames(.,var="names")
pvals.12M.gp2 <- as.data.frame(bind_rows( lapply( lms.case.12M.gp2, function(x) x$coefficients[,"Pr(>|t|)"] ))) %>% mutate(names = names(lms.case.12M.gp2)) %>% column_to_rownames(.,var="names")
colnames(pvals.12M.gp2) <- colnames(effects.12M.gp2) <- c("(Intercept)", "Sex (Male)", "LOAD2.Adamts4","LOAD2.Scimp-KI", "LOAD2.Ptk2b-KI", "LOAD2.Il34-KI")
rna_effects.12M.gp2 <- effects.12M.gp2 %>% tibble::rownames_to_column(.,"Gene") %>% dplyr::select(-"(Intercept)") %>% pivot_longer(cols=-Gene,names_to="Variant",values_to="value")
rna_pvals.12M.gp2 <- pvals.12M.gp2 %>% tibble::rownames_to_column(.,"Gene") %>% dplyr::select(-"(Intercept)") %>% pivot_longer(cols=-Gene,names_to="Variant",values_to="pval")
effects_pvals_4M.gp2  <- rna_effects.4M.gp2  %>% left_join(rna_pvals.4M.gp2,by=c("Gene","Variant")) %>% mutate(padj = p.adjust(pval,method = "fdr")) %>% filter(!(Variant %in% "Sex (Male)"))
effects_pvals_12M.gp2  <- rna_effects.12M.gp2  %>% left_join(rna_pvals.12M.gp2 ,by=c("Gene","Variant")) %>% mutate(padj = p.adjust(pval,method = "fdr")) %>% filter(!(Variant %in% "Sex (Male)"))
cor.dat <- effects_pvals_12M.gp2 %>% dplyr::select(Gene,Variant,value) %>%
pivot_wider(.,id_cols = "Gene",names_from = Variant,values_from = value) %>%
column_to_rownames(.,var="Gene")
colnames(cor.dat) <- c("Adamts4","Scimp-KI","Ptk2b-KI","Il34*Y213")
cor_mat <- cor(cor.dat, use="pairwise.complete.obs")
corrplot(cor_mat,order = "original",
is.corr = FALSE, tl.col = "black",method = "number")
cor.dat <- effects_pvals_4M.gp2 %>% dplyr::select(Gene,Variant,value) %>%
pivot_wider(.,id_cols = "Gene",names_from = Variant,values_from = value) %>%
column_to_rownames(.,var="Gene")
colnames(cor.dat) <- c("Adamts4","Scimp-KI","Ptk2b-KI","Il34*Y213")
cor_mat <- cor(cor.dat, use="pairwise.complete.obs")
corrplot(cor_mat,order = "original",
is.corr = FALSE, tl.col = "black",method = "number")
